      "id": 1,
      "title": "GPU Kernel Launch Rate (IOPS)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace, pod, resource_claim) (rate(ggate_gpu_launches_total[1m]))",
          "legendFormat": "{{namespace}}/{{pod}} ({{resource_claim}})",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "ops"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
